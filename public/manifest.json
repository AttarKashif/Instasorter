{
  "id": "instasorter-pwa",
  "name": "Instasorter - Personal Instagram Curator",
  "short_name": "Instasorter",
  "description": "A personal knowledge-management system for Instagram saved posts using local-first storage.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#09090b",
  "theme_color": "#0f172a",
  "categories": ["productivity", "utilities", "social"],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "View all saved posts",
      "url": "/",
      "icons": [{ "src": "/icon.svg", "sizes": "192x192" }]
    },
    {
      "name": "Collections",
      "short_name": "Collections",
      "description": "Browse grouped folders",
      "url": "/?view=grouped",
      "icons": [{ "src": "/icon.svg", "sizes": "192x192" }]
    }
  ]
}
